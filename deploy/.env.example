# Copy to .env / Copier en .env

# Address the team will use (DNS record pointing to this server).
# Adresse utilisée par l'équipe (enregistrement DNS pointant vers ce serveur).
SCOPEO_DOMAIN=scopeo.example.com

# Optional: long random value encrypting security secrets. If set, keep it
# forever and back it up: without it, two-factor authentication must be reset.
# Facultatif : longue valeur aléatoire qui chiffre les secrets de sécurité. Si
# elle est définie, la conserver et la sauvegarder : sans elle, la double
# authentification doit être réinitialisée.
SCOPEO_SECRET_KEY=
