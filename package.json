{
  "name": "scopeo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Open source regulatory scoping platform for the GDPR, NIS2 (ReCyF), DORA, the CRA and the AI Act",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -b --noEmit && vite build",
    "start": "npm run build && node scripts/dev.mjs --serve",
    "serve": "node scripts/dev.mjs --serve",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "node scripts/test-server.mjs",
    "demo:build": "vite-node scripts/build-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.475.0",
    "motion": "^13.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "d3-transition": "^3.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "keywords": [
    "rgpd",
    "gdpr",
    "nis2",
    "dora",
    "cra",
    "cyber-resilience-act",
    "ai-act",
    "iso27001",
    "compliance",
    "grc",
    "cybersecurity",
    "anssi",
    "recyf"
  ],
  "engines": {
    "node": ">=20"
  }
}
